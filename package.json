{
  "name": "@puertochenta/browser-guard",
  "version": "0.1.0",
  "description": "Browser runtime security: client-side observation, detection, risk scoring and reporting of suspicious behavior.",
  "keywords": [
    "security",
    "browser",
    "runtime",
    "intrusion-detection",
    "xss",
    "prototype-pollution",
    "csp"
  ],
  "license": "MIT",
  "author": "@puertochenta",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./anti-scraping": {
      "types": "./dist/anti-scraping.d.ts",
      "import": "./dist/anti-scraping.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "import": "./dist/remote.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "anti-scraping": [
        "./dist/anti-scraping.d.ts"
      ],
      "remote": [
        "./dist/remote.d.ts"
      ],
      "server": [
        "./dist/server.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.es.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test:run && pnpm build",
    "test:e2e": "pnpm build && node e2e/BuildFixtures.mjs && playwright test -c e2e/playwright.config.ts",
    "test:all": "pnpm test:run && pnpm test:e2e",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "test:package": "node tests/Package/Check.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "0.27.7",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
